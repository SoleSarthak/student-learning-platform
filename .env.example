# Copy to `.env` (never commit `.env`) before running `docker compose up`.

ENVIRONMENT=development

POSTGRES_DB=student_learning_platform
POSTGRES_USER=postgres
# Use URL-safe characters only (letters, digits, - _ .) - it is placed inside DATABASE_URL
POSTGRES_PASSWORD=change-me

# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# With ENVIRONMENT=production the API refuses to start if this is short or a placeholder.
JWT_SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origin(s) allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# URL the *browser* uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
